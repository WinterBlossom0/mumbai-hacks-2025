# ─────────────────────────────────────────────
#  Model Configuration
# ─────────────────────────────────────────────
# SMALL_MODEL   → lightweight agents (extraction, categorization, headline, rewriter) — reasoning_effort=medium
# MEDIUM_MODEL  → summarizer — 1M token context window — reasoning_effort=medium
# BIG_MODEL     → final verdict agent — reasoning_effort=xhigh
# All three support: none | low | medium | high | xhigh

SMALL_MODEL=gpt-5.4-nano
MEDIUM_MODEL=gpt-5.4-mini
BIG_MODEL=gpt-5.4
OPENAI_MODEL=gpt-5.4-nano

# ─────────────────────────────────────────────
#  OpenAI
# ─────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─────────────────────────────────────────────
#  Other AI APIs
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ─────────────────────────────────────────────
#  Tavily (Web Search)
# ─────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ─────────────────────────────────────────────
#  Supabase
# ─────────────────────────────────────────────
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# ─────────────────────────────────────────────
#  Clerk (Auth)
# ─────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# ─────────────────────────────────────────────
#  Telegram / Link Shorteners
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ANNOUNCEMENT_CHANNEL_ID=your_channel_id_here
BITLY_ACCESS_TOKEN=your_bitly_token_here
REBRANDLY_ACCESS_TOKEN=your_rebrandly_token_here

# ─────────────────────────────────────────────
#  Reddit (PRAW)
# ─────────────────────────────────────────────
YOUR_CLIENT_ID=your_reddit_client_id_here
YOUR_CLIENT_SECRET=your_reddit_client_secret_here
YOUR_USERNAME=your_reddit_username_here
YOUR_PASSWORD=your_reddit_password_here
REDDIT_USER_AGENT=TruthLens/1.0
